# CoinCraft Backend Environment Configuration
SECRET_KEY=change-to-a-secure-random-secret-key-in-production
DEBUG=True
USE_SQLITE=True
# In production, provide DATABASE_URL (PostgreSQL) or set USE_SQLITE=False and specify DB_* parameters
# DATABASE_URL=postgres://user:password@localhost:5432/coincraft_db
# DB_NAME=coincraft_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,coincraft.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=False
